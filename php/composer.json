{
  "name": "groundmail/groundmail",
  "description": "Groundmail transactional email API client for PHP",
  "version": "0.8.4",
  "type": "library",
  "license": "MIT",
  "keywords": ["email", "transactional", "groundmail"],
  "authors": [
    {
      "name": "Groundmail"
    }
  ],
  "homepage": "https://groundmail.dev",
  "support": {
    "docs": "https://docs.groundmail.dev/sdks/php",
    "issues": "https://github.com/Groundmail/groundmail-sdks/issues",
    "source": "https://github.com/Groundmail/groundmail-php"
  },
  "require": {
    "php": ">=8.1",
    "ext-json": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0"
  },
  "autoload": {
    "psr-4": {
      "Groundmail\\": "src/"
    },
    "classmap": [
      "src/Resources.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Groundmail\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit"
  }
}
