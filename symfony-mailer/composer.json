{
  "name": "groundmail/symfony-mailer",
  "description": "Symfony Mailer transport for the Groundmail transactional email API",
  "version": "0.8.4",
  "type": "library",
  "license": "MIT",
  "keywords": [
    "symfony",
    "symfony-mailer",
    "email",
    "transactional",
    "groundmail",
    "mailer"
  ],
  "authors": [
    {
      "name": "Groundmail"
    }
  ],
  "homepage": "https://groundmail.dev",
  "support": {
    "docs": "https://docs.groundmail.dev/frameworks/symfony",
    "issues": "https://github.com/Groundmail/groundmail-sdks/issues",
    "source": "https://github.com/Groundmail/groundmail-symfony-mailer"
  },
  "require": {
    "php": ">=8.1",
    "groundmail/groundmail": "^0.8.2",
    "symfony/mailer": "^6.2|^7.0",
    "symfony/mime": "^6.2|^7.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0"
  },
  "config": {
    "platform": {
      "php": "8.3.0"
    },
    "sort-packages": true
  },
  "autoload": {
    "psr-4": {
      "Groundmail\\Symfony\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Groundmail\\Symfony\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit"
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
